{
	"name": "obsidian-rag-vectordb",
	"version": "1.0.0",
	"description": "An Obsidian plugin for RAG and vector database implementation on notes",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --ext .ts",
		"test": "jest"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"rag",
		"vector-database",
		"ai",
		"tags"
	],
	"author": "Dhirajsinh Deshmukh",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^29.5.5",
		"@types/node": "^20.8.0",
		"@typescript-eslint/eslint-plugin": "^6.7.5",
		"@typescript-eslint/parser": "^6.7.5",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.19.4",
		"eslint": "^8.51.0",
		"jest": "^29.7.0",
		"obsidian": "latest",
		"ts-jest": "^29.1.1",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2"
	},
	"dependencies": {
		"@xenova/transformers": "^2.6.0",
		"chromadb": "^1.5.0"
	}
}
